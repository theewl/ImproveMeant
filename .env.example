# Copy to .env and fill in what you have. Everything is optional:
# with no keys the app runs in clearly labelled demo mode.
# Never commit .env. Keys are read only by the server.

# --- Server ---
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
# Required if HOST is not loopback and any paid provider is configured.
APP_ACCESS_TOKEN=

# --- Claude (coaching, briefings, audience questions) ---
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high
CLAUDE_EFFORT_COACHING=medium
CLAUDE_EFFORT_LIGHT=low
# default | off  (server-side refusal fallback)
CLAUDE_REFUSAL_FALLBACK=default
CLAUDE_TIMEOUT_MS=60000
CLAUDE_MAX_RETRIES=1
# Pricing assumptions for cost estimates (USD per million tokens). Verify against
# https://platform.claude.com/docs/en/about-claude/pricing for your chosen model.
CLAUDE_PRICE_INPUT_PER_MTOK=4
CLAUDE_PRICE_OUTPUT_PER_MTOK=20
CLAUDE_PRICE_CACHE_READ_PER_MTOK=0.2

# --- Usage limits (enforced server-side) ---
USAGE_DAILY_REQUEST_LIMIT=60
USAGE_DAILY_COST_LIMIT_USD=1.50
USAGE_MONTHLY_COST_LIMIT_USD=20
USAGE_DAILY_TRANSCRIPTION_MINUTES=30
MAX_RESPONSE_CHARS=6000
MAX_SOURCE_CHARS=14000

# --- Live content (Wikipedia "In the news", CC BY-SA 4.0; no key needed) ---
# wikimedia | off. Live stories are only offered when Claude is configured.
LIVE_CONTENT=wikimedia
# Wikimedia asks for a descriptive User-Agent with contact info.
CONTENT_USER_AGENT=
CONTENT_REFRESH_HOURS=6
CONTENT_MIN_SOURCE_CHARS=1800

# --- Transcription (Deepgram pre-recorded API) ---
DEEPGRAM_API_KEY=your-deepgram-api-key
DEEPGRAM_MODEL=nova-3
# Verify against Deepgram's pricing page for your plan.
TRANSCRIPTION_PRICE_PER_MINUTE_USD=0.0077
TRANSCRIPTION_TIMEOUT_MS=60000
